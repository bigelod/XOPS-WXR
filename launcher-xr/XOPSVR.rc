// XOPSVR.rc - main window, options and version information.
#include <windows.h>
#include "Resource.h"

IDD_MAIN DIALOGEX 0, 0, 250, 164
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "XOPS-WXR"
FONT 9, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "XOPS-WXR",IDC_TITLE,12,10,140,14
    LTEXT           "WinlatorXR launcher",IDC_SUBTITLE,12,24,200,10
    LTEXT           "Version --",IDC_VERSION,12,40,200,10
    PUSHBUTTON      "Play",IDC_PLAY,12,60,110,26
    PUSHBUTTON      "Options...",IDC_OPTIONS,130,60,108,16
    PUSHBUTTON      "Check for updates",IDC_CHECK,130,80,108,14
    LTEXT           "Ready.",IDC_STATUS,12,104,226,34
    PUSHBUTTON      "Quit",IDCANCEL,158,136,80,14
END

IDD_OPTIONS DIALOGEX 0, 0, 300, 258
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "XOPS-WXR - Options"
FONT 9, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Handedness",IDC_HANDED_LABEL,12,12,100,10
    COMBOBOX        IDC_HANDED,120,10,120,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    AUTOCHECKBOX    "Flip hands",IDC_HANDFLIP,12,34,150,10

    AUTOCHECKBOX    "Haptics on firing",IDC_HAPTICS,12,54,150,10

    LTEXT           "Haptics hand",IDC_HAPHAND_LABEL,12,74,100,10
    COMBOBOX        IDC_HAPHAND,120,72,120,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    AUTOCHECKBOX    "Verbose debug log",IDC_VERBOSE,12,96,150,10

    LTEXT           "Stereo (experimental)",IDC_STEREO_LABEL,12,116,100,10
    COMBOBOX        IDC_STEREO,120,114,120,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Roll direction",IDC_ROLLSIGN_LABEL,12,140,100,10
    COMBOBOX        IDC_ROLLSIGN,120,138,120,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "HMD position gain",IDC_POSSCALE_LABEL,12,162,100,10
    EDITTEXT        IDC_POSSCALE,120,160,50,14,ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "0.0-2.0  (1.0 = 1:1)",IDC_POSSCALE_HINT,176,162,110,10

    LTEXT           "HUD scale",IDC_HUDSCALE_LABEL,12,180,100,10
    EDITTEXT        IDC_HUDSCALE,120,178,50,14,ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "0.5-2.0  (1.1 default)",IDC_HUDSCALE_HINT,176,180,110,10

    LTEXT           "Settings are written to config.txt in the game folder.",IDC_SAVE_NOTE,12,204,276,20
    DEFPUSHBUTTON   "Save",IDOK,126,228,80,16
    PUSHBUTTON      "Cancel",IDCANCEL,212,228,76,16
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "XOPS-WXR"
            VALUE "FileDescription", "X Operations - WinlatorXR launcher"
            VALUE "FileVersion", "0.1.0.0"
            VALUE "InternalName", "XOPSVR"
            VALUE "OriginalFilename", "XOPSVR.exe"
            VALUE "ProductName", "XOPS-WXR"
            VALUE "ProductVersion", "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
