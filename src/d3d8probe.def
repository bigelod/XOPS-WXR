; XOPS-WXR d3d8 probe - export table
;
; Names must match the real d3d8.dll exactly, undecorated. The probe implements
; Direct3DCreate8 itself and forwards the rest with a naked jmp, so the real
; function's own calling convention and stack cleanup are preserved whatever
; they are.
LIBRARY d3d8
EXPORTS
    Direct3DCreate8                             @1
    ValidateVertexShader                        @2
    ValidatePixelShader                         @3
    DebugSetMute                                @4
    Direct3D8EnableMaximizedWindowedModeShim    @5
