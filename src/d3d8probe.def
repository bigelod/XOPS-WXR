; XOPS-WXR d3d8 probe - export table
;
; Only export what the game actually uses. The game imports Direct3DCreate8
; and looks up DebugSetMute dynamically. Exporting the other debug helpers as
; naked jumps was a trap on Wine/DXVK: GetProcAddress returned a valid export,
; but the forward pointer was NULL and the game jumped to address 0.
;
; DebugSetMute is a safe wrapper in d3d8probe.cpp, not a naked jump.
LIBRARY d3d8
EXPORTS
    Direct3DCreate8                             @1
    DebugSetMute                                @4
